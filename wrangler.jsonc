{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nozoki-dashboard",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS",
  },
  "dev": { "ip": "127.0.0.1", "port": 8787 },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nozoki-db",
      "database_id": "baa4ee9c-248b-41f5-a912-06b8824e551b",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "ADMIN_EMAIL": "lovestu44@gmail.com",
    "AUTH_VERSION": "1",
    "AUTH_ALLOW_LOCAL_HTTP": "0",
    "AUTH_ORIGIN": "https://nozoki.nekro.top",
    "INTEGRATION_KEY_VERSION": "v1",
    "NOZOKI_PUBLIC_ROUTES": "[{\"id\":\"yahoo\",\"provider\":\"quotes-custom\",\"protocolVersion\":\"yahoo-chart-v8\",\"baseUrl\":\"https://query1.finance.yahoo.com/\",\"authentication\":\"none\"}]",
  },
}
