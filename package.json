{
  "name": "nozoki-dashboard",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "theme:generate": "node scripts/generate-m3-themes.mjs",
    "dx:generate": "node scripts/build-dx-init.mjs",
    "predev": "pnpm dx:generate",
    "prebuild": "node scripts/build-prepaint.mjs",
    "test:sliders": "node tests/browser/sliders.mjs",
    "test:layout": "node tests/browser/layout012.mjs",
    "test:wallpaper": "node tests/browser/wallpaper012.mjs",
    "test:palette": "node tests/browser/palette012.mjs",
    "test:icons": "node tests/browser/icons012.mjs",
    "dev": "node scripts/dev-local.mjs",
    "predev:local": "pnpm dx:generate",
    "dev:local": "node scripts/dev-local.mjs --local-auth",
    "build": "nuxt prepare --envName=development && nuxt build",
    "prebuild:node": "node scripts/build-prepaint.mjs",
    "build:node": "node scripts/build-node.mjs",
    "start:node": "node --env-file-if-exists=.env .output-node/start.mjs",
    "db:migrate:node": "node --env-file-if-exists=.env .output-node/database.mjs migrate",
    "db:backup:node": "node --env-file-if-exists=.env .output-node/database.mjs backup",
    "collector:node": "node --env-file-if-exists=.env .output-node/collector.mjs",
    "test:node": "node --experimental-strip-types --test --test-concurrency=1 tests/self-host/*.test.mjs",
    "preview": "node scripts/local-runtime.mjs preview",
    "typecheck": "nuxt typecheck",
    "test": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:d1": "node scripts/build-collector.mjs && node scripts/local-runtime.mjs d1-tests",
    "test:d1:isolated": "node --experimental-strip-types --test --test-concurrency=1 tests/integration/*.test.mjs",
    "db:init": "node scripts/local-runtime.mjs migrate",
    "db:migrate": "node scripts/local-runtime.mjs migrate",
    "test:browser": "node tests/browser/phase013.mjs",
    "test:playback": "node tests/browser/dx-playback013.mjs",
    "test:loading": "node tests/browser/loading-followup.mjs",
    "test:loading:regression": "node tests/browser/loading-regression.mjs",
    "test:dx": "node tests/browser/dx-transition.mjs",
    "test:paint": "node tests/browser/first-paint.mjs",
    "test:performance": "node tests/browser/performance.mjs",
    "test:fallback:native": "node tests/browser/native-fallback.mjs",
    "format": "prettier --write app shared server tests scripts workers platform public/theme-init.js public/dx-init.js public/dx-init.css package.json nuxt.config.ts tsconfig.json wrangler.jsonc pnpm-workspace.yaml .prettierrc.json",
    "format:check": "prettier --check app shared server tests scripts workers platform public/theme-init.js public/dx-init.js public/dx-init.css package.json nuxt.config.ts tsconfig.json wrangler.jsonc pnpm-workspace.yaml .prettierrc.json",
    "postinstall": "nuxt prepare",
    "collector:build": "node scripts/build-collector.mjs",
    "collector:typecheck": "tsc -p workers/collector/tsconfig.json",
    "collector:preview": "node scripts/preview-collector.mjs"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@material/material-color-utilities": "0.3.0",
    "@varlet/ui": "3.20.7",
    "@vicons/material": "0.13.0",
    "nuxt": "4.6.2",
    "vue": "3.5.44",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.62.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.13",
    "wrangler": "4.152.0"
  }
}
