# Self-hosted Node.js deployment. Copy to a private .env file outside the public directory.
NOZOKI_SQLITE_PATH=/var/lib/nozoki/nozoki.sqlite
HOST=127.0.0.1
PORT=3000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_LOCAL_DEVELOPMENT_PASSWORD
AUTH_VERSION=1
AUTH_ORIGIN=https://dashboard.example.com
AUTH_RATE_LIMIT_SECRET=GENERATE_A_RANDOM_32_BYTE_BASE64URL_KEY
AUTH_ALLOW_LOCAL_HTTP=0
COLLECTOR_EPOCH=1
# Optional exact public HTTPS routes approved by the server operator. See README.
# NOZOKI_PUBLIC_ROUTES='[]'
# INTEGRATION_ENCRYPTION_KEY=GENERATE_AN_INDEPENDENT_32_BYTE_BASE64URL_KEY
# INTEGRATION_KEY_VERSION=v1
# INTEGRATION_DECRYPTION_KEYS='{"v1":"RETAIN_OLD_KEY_WHEN_ROTATING"}'
# Optional fixed read-only relay hosted inside the Node process.
# NOZOKI_RELAY_CONFIG_FILE=/etc/nozoki/private-relay.local.json
# NOZOKI_PRIVATE_RELAY_TOKEN=GENERATE_AN_INDEPENDENT_32_BYTE_BASE64URL_KEY
# NOZOKI_PRIVATE_ROUTES='[]'
# NOZOKI_RELAY_ID_KEY=GENERATE_AN_INDEPENDENT_32_BYTE_BASE64URL_KEY
# COLLECTOR_BINDING_REVISION=local-relay-v1
